rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDeviceMember(deviceData) {
      return isAuthenticated()
        && 'allowedUsers' in deviceData
        && deviceData.allowedUsers is list
        && request.auth.uid in deviceData.allowedUsers;
    }

    function isBoundedInt(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    function isValidDeviceSettingsUpdate() {
      let data = request.resource.data;
      let prev = resource.data;
      let changedKeys = data.diff(prev).affectedKeys();
      let allowedWritableKeys = [
        'threshold',
        'sensitivity',
        'duration',
        'safety_off_min',
        'remote_lamp_on',
        'restart_requested',
        'updatedAt'
      ];

      return data.allowedUsers == prev.allowedUsers
        && (!('espUid' in prev) || ('espUid' in data && data.espUid == prev.espUid))
        && changedKeys.hasOnly(allowedWritableKeys)
        && (!('threshold' in data) || isBoundedInt(data.threshold, 1, 100))
        && (!('sensitivity' in data) || isBoundedInt(data.sensitivity, 1, 100))
        && (!('duration' in changedKeys) || isBoundedInt(data.duration, 10, 600))
        && (!('safety_off_min' in data) || isBoundedInt(data.safety_off_min, 0, 1440))
        && (!('remote_lamp_on' in data) || data.remote_lamp_on is bool)
        && (!('restart_requested' in data) || data.restart_requested is bool)
        && (!('updatedAt' in changedKeys) || data.updatedAt is timestamp);
    }

    function isValidSelfUnpair() {
      let data = request.resource.data;
      let prev = resource.data;

      return data.diff(prev).affectedKeys().hasOnly(['allowedUsers'])
        && (!('espUid' in prev) || ('espUid' in data && data.espUid == prev.espUid))
        && data.allowedUsers is list
        && !(request.auth.uid in data.allowedUsers)
        && data.allowedUsers.size() == prev.allowedUsers.size() - 1
        && prev.allowedUsers.hasAll(data.allowedUsers);
    }

    match /pairing_requests/{deviceId} {
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pin is string
        && request.resource.data.pin.size() >= 6
        && request.resource.data.pin.size() <= 12
        && request.resource.data.pin.matches('^[A-Za-z0-9]{6,12}$')
        && request.resource.data.attempts == 0
        && request.resource.data.expiresAt is timestamp;
      allow read, delete: if false;
    }

    match /devices/{deviceId} {
      allow get, list: if isDeviceMember(resource.data);
      allow create, delete: if false;
      allow update: if isDeviceMember(resource.data)
        && (isValidDeviceSettingsUpdate() || isValidSelfUnpair());

      match /logs/{logId} {
        allow create, read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/devices/$(deviceId)).data.allowedUsers;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
