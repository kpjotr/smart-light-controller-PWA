rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isBoundedInt(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    function isValidCustomName(val) {
      return val is string
        && val.size() <= 32
        && val.matches('^[A-Za-z0-9 _-]{0,32}$');
    }

    function isValidCustomNamesUpdate() {
      let data = request.resource.data;
      let prev = resource.data;

      return (!('customNames' in data) && !('customNames' in prev))
        || (('customNames' in data) && ('customNames' in prev) && data.customNames == prev.customNames)
        || (
          ('customNames' in data)
          && data.customNames is map
          && data.customNames.diff(prev.get('customNames', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in data.customNames) || isValidCustomName(data.customNames[request.auth.uid]))
        );
    }

    function isValidDeviceSettingsUpdate() {
      let data = request.resource.data;
      let prev = resource.data;
      let changedKeys = data.diff(prev).affectedKeys();
      let allowedWritableKeys = [
        'threshold',
        'sensitivity',
        'duration',
        'safety_off_min',
        'remote_lamp_on',
        'restart_requested',
        'updatedAt',
        'customNames'
      ];

      return prev.allowedUsers is list
        && data.allowedUsers == prev.allowedUsers
        && (!('espUid' in prev) || ('espUid' in data && data.espUid == prev.espUid))
        && changedKeys.hasOnly(allowedWritableKeys)
        && (!('threshold' in data) || isBoundedInt(data.threshold, 1, 100))
        && (!('sensitivity' in data) || isBoundedInt(data.sensitivity, 1, 100))
        && (!('duration' in changedKeys) || isBoundedInt(data.duration, 10, 600))
        && (!('safety_off_min' in data) || isBoundedInt(data.safety_off_min, 0, 1440))
        && (!('remote_lamp_on' in data) || data.remote_lamp_on is bool)
        && (!('restart_requested' in data) || data.restart_requested is bool)
        && (!('updatedAt' in changedKeys) || data.updatedAt is timestamp)
        && isValidCustomNamesUpdate();
    }

    function isValidSelfUnpair() {
      let data = request.resource.data;
      let prev = resource.data;

      return prev.allowedUsers is list
        && data.diff(prev).affectedKeys().hasOnly(['allowedUsers', 'customNames'])
        && (!('espUid' in prev) || ('espUid' in data && data.espUid == prev.espUid))
        && data.allowedUsers is list
        && !(request.auth.uid in data.allowedUsers)
        && data.allowedUsers.size() == prev.allowedUsers.size() - 1
        && prev.allowedUsers.hasAll(data.allowedUsers)
        && isValidCustomNamesUpdate();
    }

    match /pairing_requests/{deviceId} {
      allow get: if isAuthenticated()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow list, delete: if false;
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['userId', 'pin', 'attempts', 'expiresAt', 'customName'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pin is string
        && request.resource.data.pin.size() >= 6
        && request.resource.data.pin.size() <= 12
        && request.resource.data.pin.matches('^[A-Za-z0-9]{6,12}$')
        && request.resource.data.attempts == 0
        && request.resource.data.expiresAt is timestamp
        && (!('customName' in request.resource.data) || isValidCustomName(request.resource.data.customName));
    }

    match /devices/{deviceId} {
      function isAllowedUser() {
        return isAuthenticated()
          && resource != null
          && ('allowedUsers' in resource.data)
          && (request.auth.uid in resource.data.allowedUsers);
      }

      allow get: if isAllowedUser();
      allow list: if isAuthenticated()
        && request.query.limit <= 50
        && request.auth.uid in resource.data.allowedUsers;
      allow create, delete: if false;
      allow update: if isAllowedUser()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_on_seconds'])
        && (isValidDeviceSettingsUpdate() || isValidSelfUnpair());

      match /logs/{logId} {
        allow create, read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/devices/$(deviceId)).data.allowedUsers;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
