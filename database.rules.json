{
  "rules": {
    ".read": false,
    ".write": false,
    "acl": {
      ".read": false,
      ".write": false
    },
    "live": {
      "$deviceId": {
        "cmd": {
          ".read": "auth != null && ((auth.token.role === 'device' && auth.token.deviceId === $deviceId && root.child('acl/' + $deviceId).hasChildren()) || (auth.token.role != 'device' && root.child('acl/' + $deviceId + '/' + auth.uid).val() === true))",
          ".write": "auth != null && auth.token.role != 'device' && root.child('acl/' + $deviceId + '/' + auth.uid).val() === true && newData.exists()",
          ".validate": "newData.hasChildren(['lamp', 'restart', 'thr', 'sens', 'dur', 'safe'])",
          "lamp": {
            ".validate": "newData.isBoolean()"
          },
          "restart": {
            ".write": "auth != null && auth.token.role === 'device' && auth.token.deviceId === $deviceId && root.child('acl/' + $deviceId).hasChildren() && newData.isBoolean() && newData.val() === false",
            ".validate": "newData.isBoolean()"
          },
          "unpaired": {
            ".validate": "newData.isBoolean()"
          },
          "thr": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "sens": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "dur": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 600"
          },
          "safe": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
          },
          "wattage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000 && newData.val() % 1 == 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".read": "auth != null && root.child('acl').child($deviceId).child(auth.uid).val() === true",
          ".write": "auth != null && auth.token.role === 'device' && auth.token.deviceId === $deviceId && root.child('acl').child($deviceId).child(auth.uid).val() === true && newData.exists()",
          ".validate": "newData.hasChildren(['on', 'auto', 'lux', 'mot']) && (!newData.child('online').exists() || newData.child('online').isBoolean()) && (!newData.child('last_seen').exists() || newData.child('last_seen').isNumber()) && (!newData.child('ts').exists() || newData.child('ts').isNumber())",
          "on": {
            ".validate": "newData.isBoolean()"
          },
          "auto": {
            ".validate": "newData.isBoolean()"
          },
          "lux": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 65535"
          },
          "mot": {
            ".validate": "newData.isBoolean()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "last_seen": {
            ".validate": "newData.isNumber()"
          },
          "energy_delta_sec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "wattage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000 && newData.val() % 1 == 0"
          },
          "p1_off": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
